<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<configuration>
  <property><n>javax.jdo.option.ConnectionURL</n><value>jdbc:derby:;databaseName={{ install_dir }}/hive/metastore_db;create=true</value></property>
  <property><n>javax.jdo.option.ConnectionDriverName</n><value>org.apache.derby.jdbc.EmbeddedDriver</value></property>
  <property><n>hive.metastore.uris</n><value>thrift://{{ hive_host }}:9083</value></property>
  <property><n>hive.server2.thrift.bind.host</n><value>{{ hive_host }}</value></property>
  <property><n>hive.server2.thrift.port</n><value>10000</value></property>
  <property><n>hive.server2.webui.port</n><value>10002</value></property>
  <property><n>hive.metastore.warehouse.dir</n><value>hdfs://{{ namenode_host }}:9000/user/hive/warehouse</value></property>
  <property><n>hive.exec.scratchdir</n><value>hdfs://{{ namenode_host }}:9000/tmp/hive</value></property>
  <property><n>hive.server2.authentication</n><value>NONE</value></property>
  <property><n>hive.support.concurrency</n><value>true</value></property>
  <property><n>hive.txn.manager</n><value>org.apache.hadoop.hive.ql.lockmgr.DbTxnManager</value></property>
  <property><n>hive.metastore.event.db.notification.api.auth</n><value>false</value></property>
</configuration>
