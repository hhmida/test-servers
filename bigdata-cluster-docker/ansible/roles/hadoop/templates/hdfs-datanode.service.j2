[Unit]
Description=Hadoop HDFS DataNode
After=network.target

[Service]
User={{ hadoop_user }}
Group={{ hadoop_group }}
Type=forking
ExecStart={{ install_dir }}/hadoop/bin/hdfs --daemon start datanode
ExecStop={{ install_dir }}/hadoop/bin/hdfs --daemon stop datanode
PIDFile={{ pid_dir }}/hadoop-{{ hadoop_user }}-datanode.pid
Restart=on-failure
RestartSec=10
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
