[Unit]
Description=Hadoop HDFS NameNode
After=network.target

[Service]
User={{ hadoop_user }}
Group={{ hadoop_group }}
Type=forking
ExecStart={{ install_dir }}/hadoop/bin/hdfs --daemon start namenode
ExecStop={{ install_dir }}/hadoop/bin/hdfs --daemon stop namenode
PIDFile={{ pid_dir }}/hadoop-{{ hadoop_user }}-namenode.pid
Restart=on-failure
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
